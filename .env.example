# ══════════════════════════════════════════════════════════════
# .env.example — Variables d'environnement du projet ChatBot RAG
# Copier ce fichier en .env et remplir les valeurs.
# ⚠️  Ne jamais committer .env dans git.
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# LLM — Groq (gratuit sur console.groq.com)
# ──────────────────────────────────────────────────────────────
#GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────────────────────
# CLOUDFLARE R2 — Stockage des fichiers sources (PDF, DOCX, TXT)
# Quota gratuit : 10 Go stockage + 1 M requêtes/mois, 0 € d'egress
#
# Étapes :
#   1. dash.cloudflare.com → R2 Object Storage → "Create bucket"
#      Nom suggéré : chatbot-rag-docs   (Region : automatic)
#   2. R2 → "Manage R2 API Tokens" → "Create API Token"
#      Permissions : Object Read & Write   Scope : bucket spécifique
#   3. L'Account ID se trouve dans la colonne de droite de dash.cloudflare.com
# ──────────────────────────────────────────────────────────────
#R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#R2_BUCKET_NAME=chatbot-rag-docs

# ──────────────────────────────────────────────────────────────
# HUGGINGFACE HUB — Persistance de l'index FAISS entre redémarrages
# Quota gratuit : dépôts privés illimités jusqu'à 5 Go
#
# Étapes :
#   1. huggingface.co → New → Dataset
#      Nom : chatbot-rag-index   Visibilité : Private
#   2. Settings → Access Tokens → "New token"
#      Type : Write   (nécessaire pour push)
#   HF_REPO_ID format : "votre-pseudo/chatbot-rag-index"
# ──────────────────────────────────────────────────────────────
#HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#HF_REPO_ID=votre-pseudo/chatbot-rag-index

# Clé Groq
GROQ_API_KEY=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

# CLOUDFLARE R2 — Stockage des fichiers sources (PDF, DOCX, TXT)
R2_ACCOUNT_ID=8d396d6f0e432d25711d1b14f1eb0616
R2_ACCESS_KEY_ID=9c451975f26d74c5ee74644f03eb2794
R2_SECRET_ACCESS_KEY=fc2009bd1dc022867688e052f183386ba6690ca84617252d5b8d8a56c711dbcf
R2_BUCKET_NAME=chatbot-rag-docs

# HUGGINGFACE HUB — Persistance de l'index FAISS entre redémarrages
HF_TOKEN=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
HF_REPO_ID=GomuGomuNo01/chatbot-rag-index

# ──────────────────────────────────────────────────────────────
# SERVEUR (optionnel — valeurs par défaut)
# ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
PORT=8000
